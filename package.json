{
  "name": "bubu-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "卜卜迷你工作台 —— Android 打包工程（Capacitor）",
  "scripts": {
    "icons": "powershell -ExecutionPolicy Bypass -File tools/make-icons.ps1",
    "add:android": "cap add android",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "android-assets": "powershell -ExecutionPolicy Bypass -File tools/make-android-assets.ps1",
    "build:debug": "powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1",
    "build:release": "powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1 -Variant release",
    "toolchain": "powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1 -ToolchainOnly",
    "gradle:debug": "cap sync android && cd android && gradlew.bat assembleDebug",
    "clean": "cd android && gradlew.bat clean"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
